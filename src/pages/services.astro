---
import BaseLayout from '../layouts/BaseLayout.astro';
import Services from '../components/Services.astro';
---
<BaseLayout title="Kevin Mosqueda | Servicios">
  <main class="min-h-screen bg-[#F2E8DE]">
    <div class="max-w-7xl mx-auto px-4 pt-6 pb-12 md:pt-10 md:pb-16">
      <div class="text-center mb-8">
        <h1 class="text-4xl md:text-5xl font-bold text-[#1D1D1B] mb-3 font-serif">Servicios</h1>
        <p class="text-base md:text-lg text-gray-600 max-w-2xl mx-auto px-2">
        </p>
      </div>
      
      <Services />
    </div>
  </main>
</BaseLayout>

<style is:global>
  body {
    background-color: #F2E8DE !important;
  }
</style>
