    services: [
      {
        name: 'Jellyfin',
        description: 'Peliculas y series.',
        url: 'https://stream.kevinmosqueda.dev',
        icon: '/images/jellyfin.png',
        serverAddress: 'https://stream.kevinmosqueda.dev',
        instructionImg: '/images/Jellyfin_instructions.png',
        badgeUrl: 'https://status.kevinmosqueda.dev/api/badge/1/status?style=flat-square&color=00C853&upLabel=En%20l%C3%ADnea&downLabel=Fuera%20de%20l%C3%ADnea',
      },
      {
        name: 'Jellyseerr',
        description: 'Pide las peliculas y series que quieras.',
        url: 'https://pedidos.kevinmosqueda.dev',
        icon: '/images/jellyseerr.png',
        serverAddress: 'https://pedidos.kevinmosqueda.dev',
        instructionImg: '/images/Jellyseerr_instructions.jpg',
        badgeUrl: 'https://status.kevinmosqueda.dev/api/badge/2/status?style=flat-square&color=00C853&upLabel=En%20l%C3%ADnea&downLabel=Fuera%20de%20l%C3%ADnea',
      }
    ]
