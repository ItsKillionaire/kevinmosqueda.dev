const adminService = {
  name: 'Admin Panel',
  description: 'Panel de administración del sistema y monitoreo.',
  url: 'https://dashboard.kevinmosqueda.dev',
  icon: '/images/kirbystandby.gif',
  serverAddress: 'https://dashboard.kevinmosqueda.dev',
  badgeUrl: 'https://status.kevinmosqueda.dev/api/badge/5/status?style=flat-square&color=00C853&upLabel=En%20l%C3%ADnea&downLabel=Fuera%20de%20l%C3%ADnea',
};
---

<div class="space-y-12 md:space-y-16">
  <!-- Back link and Status -->
  <div class="flex flex-col sm:flex-row justify-between items-center gap-4 mb-4">
    <a href="/" class="text-[#1D1D1B] hover:text-[#D9543E] font-semibold flex items-center transition-colors text-sm md:text-base">
      <span class="mr-2">←</span> Volver al Inicio
    </a>
    <a href="https://status.kevinmosqueda.dev" target="_blank" class="flex items-center bg-white/50 backdrop-blur-sm border border-black/5 px-4 py-1.5 rounded-full hover:bg-white/80 transition-all hover:-translate-y-0.5 text-xs md:text-sm font-medium">
      <span class="w-2 h-2 bg-[#00C853] rounded-full mr-2 animate-pulse shadow-[0_0_8px_#00C853]"></span>
      Estado del Sistema
    </a>
  </div>

  {serviceSections.map(section => (
    <section>
      <h2 class="text-xl md:text-2xl font-bold text-[#1D1D1B] mb-6 border-l-4 border-[#D9543E] pl-4">{section.title}</h2>
      
      <!-- Conditionally apply grid sizing based on isCompact flag -->
      <div class={`grid gap-6 md:gap-8 ${section.isCompact ? 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4' : 'grid-cols-1 md:grid-cols-2'}`}>
        
        {section.services.map(service => (
          <div class={`bg-white/40 backdrop-blur-md border border-white/20 rounded-2xl ${section.isCompact ? 'p-4 md:p-5' : 'p-5 md:p-6'} flex flex-col hover:shadow-xl hover:shadow-[#D9543E]/5 transition-all duration-300 group`}>
            
            <div class={`flex items-start justify-between ${section.isCompact ? 'mb-3 md:mb-4' : 'mb-4 md:mb-6'}`}>
              <div class="flex items-center space-x-4 min-w-0 w-full">
                <!-- Conditionally scale the icon box down for compact cards -->
                <div class={`flex-shrink-0 ${section.isCompact ? 'w-10 h-10 md:w-12 md:h-12 p-1.5' : 'w-14 h-14 md:w-16 md:h-16 p-2'} bg-white rounded-xl shadow-sm group-hover:scale-115 transition-transform duration-300 flex items-center justify-center overflow-hidden border border-black/[0.03]`}>
                  <img src={service.icon} alt={service.name} class="max-w-full max-h-full object-contain" />
                </div>
                <div class="min-w-0">
                  <h3 class={`font-bold text-[#1D1D1B] truncate ${section.isCompact ? 'text-base md:text-lg' : 'text-lg md:text-xl'}`}>{service.name}</h3>
                  <img src={service.badgeUrl} class="h-4 md:h-5 mt-1 rounded opacity-90 hover:opacity-100 transition-opacity" alt="Status" />
                </div>
              </div>
            </div>
            
            <p class={`text-gray-600 flex-grow leading-relaxed ${section.isCompact ? 'text-xs md:text-sm mb-4 md:mb-5' : 'text-sm md:text-base mb-6 md:mb-8'}`}>
              {service.description}
            </p>

            <div class="space-y-4 mt-auto">
              <!-- Quick Actions Row -->
              <div class="flex flex-wrap gap-2 items-center w-full">
                <!-- Acceder Web Button -->
                <a href={service.url} target="_blank" rel="noopener noreferrer" 
                   class={`bg-[#D9543E] text-white rounded-xl font-semibold hover:brightness-110 transition-all flex items-center justify-center flex-grow shadow-sm ${section.isCompact ? 'px-3 py-2 text-xs' : 'px-4 py-2.5 text-xs sm:text-sm'}`}>
                  Acceder
                </a>
                
                <!-- Server Copy Button -->
                {service.serverAddress && (
                  <button class={`copy-button bg-white text-[#1D1D1B] border border-black/10 rounded-xl hover:bg-gray-50 transition-all flex items-center justify-center group/btn font-semibold flex-grow sm:flex-grow-0 ${section.isCompact ? 'px-2 py-2 text-xs' : 'px-3.5 py-2.5 text-xs sm:text-sm'}`} 
                          data-server={service.serverAddress}>
                    <svg xmlns="http://www.w3.org/2000/svg" class={`mr-1.5 text-gray-500 group-hover/btn:text-[#D9543E] transition-colors ${section.isCompact ? 'h-3.5 w-3.5' : 'h-4 w-4'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
                    </svg>
                    <span class="button-text">Servidor</span>
                  </button>
                )}

                <!-- Mobile Guide Button -->
                {service.instructionImg && (
                  <button class="setup-button bg-[#1D1D1B] text-white px-3.5 py-2.5 rounded-xl hover:bg-[#D9543E] transition-all flex items-center justify-center text-xs sm:text-sm font-semibold flex-grow sm:flex-grow-0" 
                          data-instruction-img={service.instructionImg}>
                    📱 Guía
                  </button>
                )}

                <!-- Platform Icons (App / Play Stores) -->
                {service.iosUrl && (
                  <a href={service.iosUrl} target="_blank" class="p-2.5 bg-white border border-black/10 rounded-xl hover:bg-gray-50 transition-all flex items-center justify-center" title="App Store">
                    <svg class="w-4 h-4 sm:w-5 sm:h-5 text-gray-800" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.1 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
                    </svg>
                  </a>
                )}
                
                {service.androidUrl && (
                  <a href={service.androidUrl} target="_blank" class="p-2.5 bg-white border border-black/10 rounded-xl hover:bg-gray-50 transition-all flex items-center justify-center" title="Play Store">
                    <svg class="w-4 h-4 sm:w-5 sm:h-5 text-gray-800" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M3.609 2.115C3.218 2.316 3 2.766 3 3.329v17.341c0 .563.218 1.013.609 1.214l.063.056L13.315 12v-.083L3.672 2.059l-.063.056zM17.067 15.383l-3.352-3.351V11.93l3.353-3.352 3.978 2.261c1.13.642 1.13 1.691 0 2.333l-3.979 2.211zM3.921 1.745L13.14 10.96l2.964-2.964L3.921 1.745zM3.921 22.255L16.104 15.34l-2.964-2.964-9.219 9.219z" />
                    </svg>
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  ))}

  <!-- Admin/System Footer -->
  <footer class="mt-24 pt-10 border-t border-black/5">
    <div class="flex flex-col items-center">
      <div class="w-full max-w-2xl bg-white/40 backdrop-blur-md rounded-2xl p-5 md:p-6 border border-white/20 hover:shadow-xl hover:shadow-black/5 transition-all duration-300 group">
        <div class="flex flex-col sm:flex-row items-center sm:items-start gap-5 text-center sm:text-left">
          <div class="flex-shrink-0 w-14 h-14 md:w-16 md:h-16 bg-white rounded-xl p-2 shadow-sm group-hover:rotate-6 transition-transform duration-300 flex items-center justify-center overflow-hidden border border-black/[0.03]">
            <img src={adminService.icon} alt="Admin" class="w-full h-full object-contain" />
          </div>
          <div class="flex-grow">
            <div class="flex flex-col sm:flex-row sm:items-center gap-2 mb-2 justify-center sm:justify-start">
              <h4 class="text-lg font-bold text-[#1D1D1B]">{adminService.name}</h4>
              <img src={adminService.badgeUrl} class="h-4 rounded self-center sm:self-auto" alt="Status" />
            </div>
            <p class="text-gray-500 mb-5 text-xs md:text-sm font-medium">{adminService.description}</p>
            
            <div class="flex flex-wrap gap-2 justify-center sm:justify-start">
              <a href={adminService.url} target="_blank" class="bg-[#1D1D1B] text-white px-5 py-2 rounded-xl font-semibold hover:bg-black transition-all text-xs md:text-sm shadow-sm">
                Acceder Panel
              </a>
              <button class="copy-button bg-white text-[#1D1D1B] border border-black/10 px-4 py-2 rounded-xl hover:bg-gray-50 transition-all flex items-center group/btn text-xs md:text-sm font-semibold" 
                      data-server={adminService.serverAddress}>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1.5 text-gray-400 group-hover/btn:text-[#D9543E] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
                </svg>
                <span class="button-text">Servidor</span>
              </button>
            </div>
          </div>
        </div>
      </div>
      <p class="text-xs text-gray-400 mt-6 font-bold uppercase tracking-widest">© {new Date().getFullYear()} Kevin Mosqueda — Acceso Restringido</p>
    </div>
  </footer>
</div>

<!-- Modal for instructions -->
<div id="instructionModal" class="fixed inset-0 z-[100] hidden items-center justify-center p-3 bg-black/85 backdrop-blur-sm animate-in fade-in duration-200">
  <div class="relative max-w-sm sm:max-w-md md:max-w-xl w-full max-h-[92vh] bg-[#F2E8DE] rounded-2xl overflow-hidden shadow-2xl scale-95 transition-transform duration-200 flex flex-col" id="modalContainer">
    <button class="close-button absolute top-3 right-3 z-10 w-8 h-8 bg-black/20 hover:bg-black/35 rounded-full flex items-center justify-center transition-colors text-xl font-bold text-white shadow" aria-label="Cerrar">&times;</button>
    <div class="p-3 flex-grow flex items-center justify-center overflow-auto min-h-0">
      <img id="modalImage" src="" alt="Instructions" class="max-w-full max-h-[80vh] object-contain rounded-xl" />
    </div>
  </div>
</div>

<script>
  // Clipboard logic
  const copyButtons = document.querySelectorAll('.copy-button');
  
  copyButtons.forEach(button => {
    button.addEventListener('click', async () => {
      const server = button.getAttribute('data-server');
      const textSpan = button.querySelector('.button-text');
      if (!textSpan) return;
      const originalText = textSpan.textContent;

      try {
        await navigator.clipboard.writeText(server || '');
        
        // Feedback state
        textSpan.textContent = '¡Copiado!';
        button.classList.add('bg-green-50', 'border-green-200');
        
        setTimeout(() => {
          textSpan.textContent = originalText;
          button.classList.remove('bg-green-50', 'border-green-200');
        }, 2000);
      } catch (err) {
        console.error('Error copying text: ', err);
      }
    });
  });

  // Modal logic
  const modal = document.getElementById('instructionModal');
  const modalContainer = document.getElementById('modalContainer');
  const modalImage = document.getElementById('modalImage') as HTMLImageElement;
  const closeButton = document.querySelector('.close-button');
  const setupButtons = document.querySelectorAll('.setup-button');

  setupButtons.forEach(button => {
    button.addEventListener('click', (event) => {
      event.preventDefault();
      const imageUrl = (button as HTMLElement).dataset.instructionImg;
      if (imageUrl && modal && modalImage && modalContainer) {
        modalImage.src = imageUrl;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        setTimeout(() => {
          modalContainer.classList.remove('scale-95');
          modalContainer.classList.add('scale-100');
        }, 10);
        document.body.style.overflow = 'hidden';
      }
    });
  });

  const closeModal = () => {
    if (modal && modalContainer) {
      modalContainer.classList.remove('scale-100');
      modalContainer.classList.add('scale-95');
      setTimeout(() => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
      }, 200);
    }
  };

  closeButton?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });
</script>

<style>
  /* Base styles to complement Tailwind */
  .font-serif {
    font-family: 'Playfair Display', serif;
  }
  
  /* Ensure smooth transitions for modal */
  .animate-in {
    animation-duration: 200ms;
  }
</style>
