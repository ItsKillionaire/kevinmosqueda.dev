        url: 'https://storyteller.kevinmosqueda.dev',
        icon: 'https://raw.githubusercontent.com/dan-lovelace/storyteller/main/core/assets/logo.png',
        serverAddress: 'https://storyteller.kevinmosqueda.dev',
        iosUrl: 'https://apps.apple.com/app/storyteller-client/id6473859765',
        androidUrl: 'https://play.google.com/store/apps/details?id=com.storyteller.app',
        instructionImg: '/images/Jellyfin_instructions.png', // Placeholder or generic
        badgeUrl: 'https://status.kevinmosqueda.dev/api/badge/7/status?style=flat-square&color=00C853&upLabel=En%20l%C3%ADnea&downLabel=Fuera%20de%20l%C3%ADnea',
