        icon: 'data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 24 24" fill="none" stroke="%231D1D1B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path><line x1="12" y1="19" x2="12" y2="22"></line></svg>',
        badgeUrl: 'https://status.kevinmosqueda.dev/api/badge/23/status?style=flat-square&color=00C853&upLabel=En%20l%C3%ADnea&downLabel=Fuera%20de%20l%C3%ADnea',
