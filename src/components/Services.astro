const adminService = {
  name: 'Admin Panel',
  description: 'Panel de administración del sistema y monitoreo.',
  url: 'https://dashboard.kevinmosqueda.dev',
  icon: '/images/kirbystandby.gif',
  serverAddress: 'https://dashboard.kevinmosqueda.dev',
  badgeUrl: 'https://status.kevinmosqueda.dev/api/badge/5/status?style=flat-square&color=00C853&upLabel=En%20l%C3%ADnea&downLabel=Fuera%20de%20l%C3%ADnea',
};
---

<div class="space-y-20">
  <!-- Back link and Status -->
  <div class="flex flex-col sm:flex-row justify-between items-center gap-4 mb-8">
    <a href="/" class="text-[#1D1D1B] hover:text-[#D9543E] font-semibold flex items-center transition-colors">
      <span class="mr-2">←</span> Volver al Inicio
    </a>
    <a href="https://status.kevinmosqueda.dev" target="_blank" class="flex items-center bg-white/50 backdrop-blur-sm border border-black/5 px-4 py-2 rounded-full hover:bg-white/80 transition-all hover:-translate-y-0.5 text-sm font-medium">
      <span class="w-2 h-2 bg-[#00C853] rounded-full mr-2 animate-pulse shadow-[0_0_8px_#00C853]"></span>
      Estado del Sistema
    </a>
  </div>

  {serviceSections.map(section => (
    <section>
      <h2 class="text-2xl font-bold text-[#1D1D1B] mb-8 border-l-4 border-[#D9543E] pl-4">{section.title}</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {section.services.map(service => (
          <div class="bg-white/40 backdrop-blur-md border border-white/20 rounded-2xl p-6 flex flex-col hover:shadow-xl hover:shadow-[#D9543E]/5 transition-all duration-300 group">
            <div class="flex items-start justify-between mb-6">
              <div class="flex items-center space-x-4 min-w-0">
                <div class="flex-shrink-0 w-16 h-16 bg-white rounded-xl p-2 shadow-sm group-hover:scale-110 transition-transform duration-300 flex items-center justify-center overflow-hidden">
                  <img src={service.icon} alt={service.name} class="max-w-full max-h-full object-contain" />
                </div>
                <div class="min-w-0">
                  <h3 class="text-xl font-bold text-[#1D1D1B] truncate">{service.name}</h3>
                  <img src={service.badgeUrl} class="h-5 mt-1 rounded opacity-90 hover:opacity-100 transition-opacity" alt="Status" />
                </div>
              </div>
            </div>
            
            <p class="text-gray-600 mb-8 flex-grow leading-relaxed">
              {service.description}
            </p>

            <div class="space-y-4">
              <!-- Quick Actions -->
              <div class="flex flex-wrap gap-2 items-center">
                <a href={service.url} target="_blank" rel="noopener noreferrer" 
                   class="bg-[#D9543E] text-white px-5 py-2.5 rounded-xl font-semibold hover:brightness-110 transition-all flex items-center justify-center flex-grow sm:flex-grow-0 text-sm">
                  Acceder Web
                </a>
                
                <button class="copy-button bg-white text-[#1D1D1B] border border-black/10 px-4 py-2.5 rounded-xl hover:bg-gray-50 transition-all flex items-center justify-center group/btn text-sm" 
                        data-server={service.serverAddress}>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 text-gray-500 group-hover/btn:text-[#D9543E] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
                  </svg>
                  <span class="button-text">Servidor</span>
                </button>

                <div class="flex gap-2">
                  {service.iosUrl && (
                    <a href={service.iosUrl} target="_blank" class="p-2.5 bg-white border border-black/10 rounded-xl hover:bg-gray-50 transition-all" title="App Store">
                      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.1 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
                      </svg>
                    </a>
                  )}
                  
                  {service.androidUrl && (
                    <a href={service.androidUrl} target="_blank" class="p-2.5 bg-white border border-black/10 rounded-xl hover:bg-gray-50 transition-all" title="Play Store">
                      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.61 3,21.09 3,20.5M16.81,15.12L18.66,16.19C19.28,16.55 19.28,17.45 18.66,17.81L14.52,20.22L12.13,17.8L16.81,15.12M14.52,3.78L18.66,6.19C19.28,6.55 19.28,7.45 18.66,7.81L16.81,8.88L12.13,6.2L14.52,3.78M12.97,12.72L4.54,21.15L15.38,14.88L12.97,12.72M12.97,11.28L15.38,9.12L4.54,2.85L12.97,11.28Z"/>
                      </svg>
                    </a>
                  )}
                </div>

                <button class="setup-button ml-auto text-sm font-bold text-[#D9543E] hover:underline whitespace-nowrap" data-instruction-img={service.instructionImg}>
                  📱 Guía Móvil
                </button>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  ))}

  <!-- Admin/System Footer -->
  <footer class="mt-32 pt-12 border-t border-black/5">
    <div class="flex flex-col items-center">
      <div class="w-full max-w-2xl bg-black/5 rounded-3xl p-8 border border-black/5 hover:bg-black/[0.07] transition-all duration-300 group">
        <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 text-center sm:text-left">
          <div class="flex-shrink-0 w-20 h-20 bg-white rounded-2xl p-2 shadow-sm group-hover:rotate-6 transition-transform duration-300 flex items-center justify-center overflow-hidden">
            <img src={adminService.icon} alt="Admin" class="w-full h-full object-contain" />
          </div>
          <div class="flex-grow">
            <div class="flex flex-col sm:flex-row sm:items-center gap-3 mb-2 justify-center sm:justify-start">
              <h4 class="text-xl font-bold text-[#1D1D1B]">{adminService.name}</h4>
              <img src={adminService.badgeUrl} class="h-5 rounded self-center sm:self-auto" alt="Status" />
            </div>
            <p class="text-gray-500 mb-6 text-sm font-medium">{adminService.description}</p>
            
            <div class="flex flex-wrap gap-3 justify-center sm:justify-start">
              <a href={adminService.url} target="_blank" class="bg-[#1D1D1B] text-white px-6 py-2.5 rounded-xl font-semibold hover:bg-black transition-all text-sm">
                Acceder Panel
              </a>
              <button class="copy-button bg-white text-[#1D1D1B] border border-black/10 px-4 py-2.5 rounded-xl hover:bg-gray-50 transition-all flex items-center group/btn text-sm" 
                      data-server={adminService.serverAddress}>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 text-gray-400 group-hover/btn:text-[#D9543E]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
                </svg>
                <span class="button-text">Servidor</span>
              </button>
            </div>
          </div>
        </div>
      </div>
      <p class="text-xs text-gray-400 mt-8 font-bold uppercase tracking-widest">© {new Date().getFullYear()} Kevin Mosqueda — Acceso Restringido</p>
    </div>
  </footer>
</div>

<!-- Modal for instructions -->
<div id="instructionModal" class="fixed inset-0 z-[100] hidden items-center justify-center p-4 bg-black/80 backdrop-blur-sm animate-in fade-in duration-300">
  <div class="relative max-w-4xl w-full bg-[#F2E8DE] rounded-3xl overflow-hidden shadow-2xl scale-95 transition-transform duration-300" id="modalContainer">
    <button class="close-button absolute top-4 right-4 z-10 w-10 h-10 bg-black/10 hover:bg-black/20 rounded-full flex items-center justify-center transition-colors text-2xl font-bold">&times;</button>
    <div class="p-2">
      <img id="modalImage" src="" alt="Instructions" class="w-full h-auto rounded-2xl shadow-inner" />
    </div>
  </div>
</div>

<script>
  // Clipboard logic
  const copyButtons = document.querySelectorAll('.copy-button');
  
  copyButtons.forEach(button => {
    button.addEventListener('click', async () => {
      const server = button.getAttribute('data-server');
      const textSpan = button.querySelector('.button-text');
      if (!textSpan) return;
      const originalText = textSpan.textContent;

      try {
        await navigator.clipboard.writeText(server || '');
        
        // Feedback state
        textSpan.textContent = '¡Copiado!';
        button.classList.add('bg-green-50', 'border-green-200');
        
        setTimeout(() => {
          textSpan.textContent = originalText;
          button.classList.remove('bg-green-50', 'border-green-200');
        }, 2000);
      } catch (err) {
        console.error('Error copying text: ', err);
      }
    });
  });

  // Modal logic
  const modal = document.getElementById('instructionModal');
  const modalContainer = document.getElementById('modalContainer');
  const modalImage = document.getElementById('modalImage') as HTMLImageElement;
  const closeButton = document.querySelector('.close-button');
  const setupButtons = document.querySelectorAll('.setup-button');

  setupButtons.forEach(button => {
    button.addEventListener('click', (event) => {
      event.preventDefault();
      const imageUrl = (button as HTMLElement).dataset.instructionImg;
      if (imageUrl && modal && modalImage && modalContainer) {
        modalImage.src = imageUrl;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        setTimeout(() => {
          modalContainer.classList.remove('scale-95');
          modalContainer.classList.add('scale-100');
        }, 10);
        document.body.style.overflow = 'hidden';
      }
    });
  });

  const closeModal = () => {
    if (modal && modalContainer) {
      modalContainer.classList.remove('scale-100');
      modalContainer.classList.add('scale-95');
      setTimeout(() => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
      }, 200);
    }
  };

  closeButton?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });
</script>

<style>
  /* Base styles to complement Tailwind */
  .font-serif {
    font-family: 'Playfair Display', serif;
  }
  
  /* Ensure smooth transitions for modal */
  .animate-in {
    animation-duration: 300ms;
  }
</style>
